APP_ENV=development
APP_NAME=NITKSAA Event API
APP_VERSION=0.1.0-alpha

# events_db PostgreSQL connection
EVENTS_DB_URL=postgresql://postgres:postgres@localhost:5432/events_db

# alumni_db PostgreSQL connection (read-only cross-database lookups)
# Required for alumni eligibility checks. Create locally with: createdb alumni_db
# Point to the portal's staging DB when testing against real alumni data.
ALUMNI_DB_URL=postgresql://postgres:postgres@localhost:5432/alumni_db

# Email
# EMAIL_MODE=log  → log-only, no real email sent (safe for development, default)
# EMAIL_MODE=send → sends via Gmail SMTP; requires SMTP_USER and SMTP_PASSWORD
EMAIL_MODE=log
# EMAIL_FROM=nitksaa.events@gmail.com
# EMAIL_REPLY_TO=events@nitksaa.org
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=nitksaa.events@gmail.com
# SMTP_PASSWORD=your-gmail-app-password

# Payments — gateway-neutral foundation (no real gateway credentials; only
# deterministic_sandbox is registered in app/gateways/registry.py so far)
PAYMENT_GATEWAY_MODE=deterministic_sandbox
PAYMENT_SANDBOX_SIGNING_SECRET=
# Oldest signed webhook created_at accepted. Must cover Razorpay's 24-hour
# retry horizon — 90000 (25 h) is the default; never set it back to 300.
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=90000
PAYMENT_DIAGNOSTICS_ENABLED=true
# Fail-closed: keep false everywhere except a deliberate non-production demo
# environment that happens to run with APP_ENV=production.
PAYMENT_SANDBOX_ALLOW_IN_PRODUCTION=false

# Razorpay — ONE active credential set per deployment. RAZORPAY_MODE must be
# test or live: test requires a rzp_test_ key id, live a rzp_live_ key id,
# otherwise Razorpay fails closed. Payments/refunds/webhooks whose
# payment_mode differs from RAZORPAY_MODE never use these credentials.
# Beta: RAZORPAY_MODE=test + Test keys. Production: RAZORPAY_MODE=live +
# Live keys. Server-only secrets — never commit real values.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

