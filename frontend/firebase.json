{
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "project-d22bed42-f302-4e23-8dc",
          "configurations": {
            "web": "1:246773894709:web:c4d4d005ec66432a33ab7c"
          }
        }
      }
    }
  },
  "hosting": [
    {
      "target": "events",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|mjs|json|wasm|md)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
